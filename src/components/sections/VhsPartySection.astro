---
import { RetroVhsPlayer } from '../interactive/RetroVhsPlayer';
import { BirthdayCalculator } from '../interactive/BirthdayCalculator';
import { Disc3, Sparkles, Ticket, Flame, ExternalLink } from '../ui/Icons';
---

<section id="festejos-dj" class="scroll-mt-24 py-24 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto border-b border-surface-border">
  <div class="text-center max-w-3xl mx-auto mb-12">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono font-bold uppercase bg-cosme-red/10 text-cosme-red border border-cosme-red/20 mb-3">
      <Disc3 className="w-3.5 h-3.5 text-cosme-red animate-spin" />
      Noches de Fiesta & Cumpleaños
    </div>
    <h2 class="font-display text-3xl sm:text-5xl font-black tracking-tight uppercase text-textPrimary mb-4">
      Fiestas Retro & Cumpleaños en Cosme
    </h2>
    <p class="text-textSecondary text-base sm:text-lg">
      Viví los 90s y 2000s con DJs en vivo, visuales en camcorder VHS, cotillón flúo LED y menús de comida libre diseñados para que vos solo te preocupes por pasarla bien.
    </p>
  </div>

  <!-- Featured Upcoming Event Banner from Evento Simple / Linktree -->
  <div class="mb-12 p-6 sm:p-8 rounded-3xl bg-gradient-to-r from-[#2B1015] via-surface-card to-[#20150A] border-2 border-cosme-red/60 shadow-[0_0_35px_rgba(255,30,39,0.25)] flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
    <div class="flex items-start sm:items-center gap-4">
      <div class="w-14 h-14 rounded-2xl bg-cosme-red/20 border border-cosme-red/40 flex items-center justify-center text-cosme-red shrink-0">
        <Ticket className="w-7 h-7" />
      </div>
      <div>
        <div class="flex flex-wrap items-center gap-2 mb-1.5">
          <span class="px-2.5 py-0.5 rounded-full text-[10px] font-mono font-extrabold uppercase bg-cosme-red text-white animate-pulse">
            Próximo Evento Oficial
          </span>
          <span class="text-xs font-mono text-[#FFAA00] font-bold">
            22.NOV · 23:59 hs
          </span>
        </div>
        <h3 class="font-display text-xl sm:text-2xl font-black text-white">
          BARLEY FEST EN COSME — VÍSPERA DE FERIADO
        </h3>
        <p class="text-xs sm:text-sm text-textSecondary">
          Domingo 22/11 · Pub y Restaurante Cosme Alberdi · Entradas anticipadas en venta oficial.
        </p>
      </div>
    </div>

    <a
      href="https://compras.evento-simple.com/cosme"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center justify-center gap-2.5 py-3.5 px-6 rounded-xl font-display font-extrabold text-xs uppercase tracking-wider text-white bg-cosme-red hover:bg-cosme-redDark shadow-[0_0_20px_rgba(255,30,39,0.4)] transition-all shrink-0 hover:scale-105 active:scale-95"
    >
      <Ticket className="w-4 h-4" />
      <span>Comprar Entradas Online</span>
      <ExternalLink className="w-3.5 h-3.5" />
    </a>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <!-- Left Column: Retro VHS Camcorder Player Island -->
    <div class="lg:col-span-5 w-full">
      <div class="mb-4">
        <h3 class="font-display text-xl font-bold text-textPrimary flex items-center gap-2">
          <span>El Club en Directo</span>
          <span class="text-xs font-mono text-cosme-red font-semibold bg-cosme-red/10 px-2 py-0.5 rounded-full border border-cosme-red/20">OSD LIVE</span>
        </h3>
        <p class="text-xs text-textSecondary font-mono mt-1">Conmutá entre las cintas de archivo de nuestras fiestas</p>
      </div>
      <RetroVhsPlayer client:visible />
    </div>

    <!-- Right Column: Birthday & Group Quote Calculator Island -->
    <div class="lg:col-span-7 w-full">
      <BirthdayCalculator client:visible />
    </div>
  </div>
</section>
