---
import { CosmeLogo } from '../branding/CosmeLogo';
import { IndustrialSwitch } from '../interactive/IndustrialSwitch';
import { MobileDrawer } from '../interactive/MobileDrawer';
import { MessageCircle } from '../ui/Icons';
---

<header class="fixed top-0 left-0 right-0 z-40 bg-surface-card/80 backdrop-blur-md border-b border-surface-border transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    <!-- Brand Link -->
    <a href="#hero" class="flex items-center gap-3 group shrink-0 mr-4" aria-label="Cosme Alberdi — Inicio">
      <div class="w-10 h-12 flex items-center justify-center p-1 rounded-xl bg-black/40 border border-surface-border group-hover:border-cosme-red/60 transition-colors">
        <CosmeLogo client:visible />
      </div>
      <div>
        <span class="block font-brand text-lg sm:text-xl font-black tracking-wider text-textPrimary group-hover:text-cosme-red transition-colors">
          COSME ALBERDI
        </span>
        <span class="block font-mono text-[10px] sm:text-xs text-textSecondary uppercase tracking-widest">
          Bv. Rondeau 1602 · Rosario
        </span>
      </div>
    </a>

    <!-- Desktop Nav Links -->
    <nav class="hidden lg:flex items-center gap-6 xl:gap-8 font-display font-bold text-sm tracking-wide text-textSecondary" aria-label="Navegación principal">
      <a href="#accesos-rapidos" class="text-cosme-red hover:text-white flex items-center gap-1.5 transition-colors">
        <span class="w-1.5 h-1.5 rounded-full bg-cosme-red animate-ping"></span>
        Entradas & Links
      </a>
      <a href="#el-lugar" class="hover:text-cosme-red transition-colors">
        El Espacio
      </a>
      <a href="#menu-interactivo" class="hover:text-cosme-red transition-colors">
        Carta Día & Noche
      </a>
      <a href="#festejos-dj" class="hover:text-cosme-red transition-colors">
        Cumpleaños & VHS 90s
      </a>
      <a href="#cartas-pdf" class="hover:text-cosme-red transition-colors">
        Cartas Oficiales
      </a>
      <a href="#ubicacion" class="hover:text-cosme-red transition-colors">
        Ubicación
      </a>
    </nav>

    <!-- Header Actions -->
    <div class="flex items-center gap-4">
      <!-- Theme Switcher (Hydrated Island) -->
      <div class="hidden sm:block">
        <IndustrialSwitch client:load />
      </div>

      <!-- WhatsApp Direct CTA -->
      <a
        href="https://wa.me/5493416802275?text=Hola%20Cosme%20Alberdi!%20Quiero%20reservar%20una%20mesa."
        target="_blank"
        rel="noopener noreferrer"
        class="hidden sm:inline-flex items-center gap-2 py-2.5 px-5 rounded-xl text-xs font-display font-extrabold uppercase tracking-wider text-white bg-cosme-red hover:bg-cosme-redDark shadow-[0_0_20px_rgba(255,30,39,0.35)] transition-all duration-300 hover:scale-105 active:scale-95"
      >
        <MessageCircle className="w-4 h-4" />
        <span>Reservar Mesa</span>
      </a>

      <!-- Mobile Menu Drawer (Hydrated Island) -->
      <MobileDrawer client:load />
    </div>
  </div>
</header>
